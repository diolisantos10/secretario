# ============ Obrigatório ============
DATABASE_URL=postgresql://user:password@host:5432/railway

# ============ Canal de comunicação ============
# Use Telegram (mais fácil) OU WhatsApp Meta (mais complexo)

# Telegram via @BotFather
TELEGRAM_BOT_TOKEN=<seu_token_do_telegram>

# Ou WhatsApp Cloud API (Meta)
META_PHONE_NUMBER_ID=<seu_phone_number_id>
META_ACCESS_TOKEN=<seu_access_token>
META_VERIFY_TOKEN=<seu_verify_token>
META_APP_SECRET=<seu_app_secret>

# ============ Claude (Anthropic) ============
ANTHROPIC_API_KEY=<sua_chave_anthropic>
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_EFFORT=medium

# ============ Painel web ============
PANEL_PASSWORD=<escolha_uma_senha>
PUBLIC_URL=<sua_url_publica_railway>

# ============ Preferências ============
OWNER_NAME=chefe
TIMEZONE=America/Sao_Paulo
BRIEFING_TIME=07:30
JOB_SEARCH_TIME=09:00

# ============ Opcional ============
OPENAI_API_KEY=<chave_openai_para_imagens>
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
GOOGLE_REDIRECT_URI=<url_publica>/oauth/google/callback
ENCRYPTION_KEY=<chave_de_32_bytes_em_hex>
LOG_LEVEL=info
PORT=8080
